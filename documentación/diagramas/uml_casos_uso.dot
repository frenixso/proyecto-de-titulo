digraph G {
 graph [rankdir=LR, bgcolor="white", pad="0.25", nodesep="0.34", ranksep="0.65", fontname="Arial", label="Casos de uso principales del sistema", labelloc=t, fontsize=17];
 node [fontname="Arial", fontsize=10, color="#2F5D7E"];
 actor1 [shape=plaintext,label="Visitante\n(no autenticado)"];
 actor2 [shape=plaintext,label="Funcionario\nautenticado"];
 actor3 [shape=plaintext,label="Administrador /\nSuperadmin"];
 subgraph cluster_sys { label="Sistema CESFAM"; style="rounded"; color="#C6D6E4";
 u1 [shape=ellipse,label="Consultar información\ninstitucional"];
 u2 [shape=ellipse,label="Solicitar hora\n(consulta de disponibilidad)"];
 u3 [shape=ellipse,label="Registrar reserva\ny validar nuevamente"];
 u4 [shape=ellipse,label="Iniciar / cerrar sesión"];
 u5 [shape=ellipse,label="Gestionar horarios,\nservicios y reservas"];
 u6 [shape=ellipse,label="Administrar noticias,\ntutoriales y multimedia"];
 u7 [shape=ellipse,label="Administrar roles\ny permisos"];
 }
 actor1 -> u1; actor1 -> u2; u2 -> u3 [style=dashed,label="incluye"];
 actor2 -> u4; actor2 -> u5; actor2 -> u6;
 actor3 -> u7; actor3 -> u5; actor3 -> u6;
}
