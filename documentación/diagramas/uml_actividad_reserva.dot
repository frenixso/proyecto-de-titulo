digraph G {
 graph [rankdir=TB, bgcolor="white", pad="0.25", nodesep="0.32", ranksep="0.38", fontname="Arial", label="Actividad — solicitud pública de una hora", labelloc=t, fontsize=17];
 node [shape=box, style="rounded,filled", fillcolor="#F3F7FB", color="#2F5D7E", fontname="Arial", fontsize=10, margin="0.13,0.08"];
 edge [color="#536B7A", fontname="Arial", fontsize=9, arrowsize=0.8];
 start [shape=circle,label="",width=.18,height=.18,fillcolor="#2F5D7E"];
 input [label="Ingresar datos y seleccionar\ndepartamento, servicio y fecha"];
 query [label="PHP consulta disponibilidad\nen PostgreSQL"];
 available [shape=diamond,label="¿Hay horas\ndisponibles?",style=filled,fillcolor="#FFF7E9"];
 select [label="Seleccionar horario y\nenviar solicitud"];
 recheck [label="PHP revalida cupo y\ndisponibilidad actual"];
 valid [shape=diamond,label="¿Sigue disponible?",style=filled,fillcolor="#FFF7E9"];
 save [label="Registrar reserva\nsegún reglas aprobadas"];
 success [label="Mostrar confirmación"];
 reject [label="Informar falta de horas\no conflicto; permitir reintento"];
 end [shape=doublecircle,label="",width=.2,height=.2];
 start -> input -> query -> available;
 available -> select [label="Sí"]; available -> reject [label="No"];
 select -> recheck -> valid;
 valid -> save [label="Sí"]; valid -> reject [label="No"];
 save -> success -> end; reject -> end;
}