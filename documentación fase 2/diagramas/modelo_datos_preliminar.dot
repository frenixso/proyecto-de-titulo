digraph G {
 graph [rankdir=LR, bgcolor="white", pad="0.25", nodesep="0.45", ranksep="0.7", fontname="Arial", label="Modelo lógico preliminar — no sustituye la introspección SQL", labelloc=t, fontsize=17];
 node [shape=record, style="filled", fillcolor="#F3F7FB", color="#2F5D7E", fontname="Arial", fontsize=10, margin="0.10"];
 edge [color="#536B7A", fontname="Arial", fontsize=9, arrowsize=0.8];
 dept [label="{departamentos|id_departamento (PK)\lnombre\lactivo\lhorarios_unificados\l}"];
 serv [label="{servicios|id_servicio (PK)\lid_departamento (FK)\lnombre, descripcion\lactivo\l}"];
 agenda [label="{agendas|id_agenda (PK)\lcolumnas por verificar\lrelación operativa por validar\l}", fillcolor="#FFF7E9", color="#C18A3A"];
 slot [label="{horarios|id_horario (PK)\lid_servicio (FK)\lfecha, hora, estado\lid_agenda: asociación observada pendiente\l}"];
 res [label="{reservas|id_reserva (PK)\lFK y campos exactos por verificar\lnombre / identificador / teléfono / correo\lestados y restricciones por verificar\l}"];
 staff [label="{funcionarios|id_funcionario (PK)\lid_departamento (referencia)\lrol / activo / credenciales: verificar\l}"];
 dept -> serv [label="1 : N"];
 serv -> slot [label="1 : N"];
 agenda -> slot [style=dashed,label="asociación pendiente de validar"];
 slot -> res [label="relación lógica; cardinalidad por validar"];
 dept -> staff [label="1 : N (según código consultado)"];
}
